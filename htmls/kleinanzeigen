            track.style.transform = "translateX(-" + offset + "px)";

            if (prevBtn) {
                prevBtn.classList.toggle('scroll-disabled', currentPage === 0);
            }
            if (nextBtn) {
                nextBtn.classList.toggle('scroll-disabled', currentPage >= totalPages - 1);
            }
