<script data-cmp-info="6">
    $(function() {
        $('#phone_numbers_modal').one('shown.bs.modal', function() {
            $.when(
                services.profiles.getContactDataByUserId(
                    $(this).data('user_id'),
                    $(this).data('asset_type'),
                    $(this).data('asset_id')
                )
            ).done(function(response){
                var name = response.public_name;
                if (response.company_name && response.verified_user === "1" && response.name_display_status !== '0') {
                    name += '<br>' + response.company_name;
                }

                if (response.company_name && response.verified_user === "1" && response.name_display_status === '0') {
                    name = response.company_name;
                }

                if (!response.company_name && response.verified_user === "1" && response.name_display_status === '0') {
                    name = response.public_name;
                }
                $('#phone_numbers_modal').find('.contacted_user_name').text(name);

                if (response.telephone) {
                    $('#phone_numbers_modal').find('.telephone_number').text(response.telephone);
                } else {
                    $('#phone_numbers_modal').find('.telephone_label').hide();
                }

                if (response.mobile) {
                    $('#phone_numbers_modal').find('.mobile_number').text(response.mobile);
                } else {
                    $('#phone_numbers_modal').find('.mobile_label').hide();
                }

                $('#phone_numbers_modal').find('.ajax_loader_gif').hide();
                $('#phone_numbers_modal').find('.phone_numbers_content').show();
            });
        });
    });
</script>



