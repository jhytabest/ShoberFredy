#!/usr/bin/env python3
"""Builds (or, with --check, verifies) every dashboard this repo generates.

One repo, more than one dashboard now: fredy-hunt answers "am I going to
find a flat", fredy-pipeline answers "is the machinery working". Each has
its own generator script; this just runs all of them so `yarn dashboard:build`
/ `yarn dashboard:check` stay a single command.
"""
import os
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
GENERATORS = ["fredy_hunt.py", "fredy_pipeline.py"]

for generator in GENERATORS:
    result = subprocess.run([sys.executable, os.path.join(HERE, generator), *sys.argv[1:]])
    if result.returncode != 0:
        sys.exit(result.returncode)
