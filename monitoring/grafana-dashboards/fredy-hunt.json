        "w": 8,
        "x": 8,
        "y": 24
      },
      "options": {
        "displayMode": "gradient",
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "maxVizHeight": 300,
        "minVizHeight": 16,
        "minVizWidth": 8,
        "namePlacement": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "showUnfilled": true,
        "sizing": "auto",
        "valueMode": "color"
      },
      "repeatDirection": "h",
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "fredy-sqlite"
          },
          "format": "table",
          "queryText": "\n                        SELECT printf('%.2f, %.2f', ROUND(l.latitude, 2), ROUND(l.longitude, 2)) AS area,\n                               ROUND(AVG(l.price / l.size), 2) AS eur_per_sqm\n                        FROM listings l\n                        WHERE l.market = '$market' AND l.state = 'active'\n                          AND l.latitude IS NOT NULL AND l.longitude IS NOT NULL\n                          AND l.price > 0 AND l.size > 0\n                        GROUP BY ROUND(l.latitude, 2), ROUND(l.longitude, 2)\n                        HAVING COUNT(*) >= 2\n                        ",
          "refId": "A"
        }
      ],
      "title": "Price heat by area",
      "transformations": [
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "desc": true,
                "field": "eur_per_sqm"
              }
            ]
          }
        }
      ],
      "transparent": false,
      "type": "bargauge"
    },
