            "uid": "fredy-sqlite"
          },
          "format": "table",
          "queryText": "SELECT COALESCE((SELECT count FROM llm_budget_usage WHERE day = strftime('%s','now','start of day') * 1000), 0) AS used",
          "refId": "A"
        }
      ],
      "title": "LLM budget used today",
