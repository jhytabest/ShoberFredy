    {
      "description": "Every active advert this market's job has accepted, positioned by geocode and coloured by how far below (blue) or above (red) the model's fair price it asks.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-BlYlRd"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "options": {
        "basemap": {
          "config": {},
          "name": "OpenStreetMap",
          "type": "default"
        },
        "controls": {
          "mouseWheelZoom": true,
          "showAttribution": true,
          "showZoom": true
        },
        "layers": [
          {
            "config": {
              "showLegend": true,
              "style": {
                "color": {
                  "field": "delta_percent",
                  "fixed": "#56B4E9",
                  "max": 30,
                  "min": -30
                },
                "opacity": 0.8,
                "size": {
                  "fixed": 6,
                  "max": 14,
                  "min": 4
                }
              }
            },
            "name": "listings",
            "opacity": 80,
            "tooltip": true,
            "type": "markers"
          }
        ],
        "tooltip": {
          "mode": "details"
        },
        "view": {
          "allLayers": true,
          "id": "fit",
          "lat": 52.52,
          "lon": 13.405,
          "zoom": 10
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "fredy-sqlite"
          },
          "format": "table",
          "queryText": "\n                        SELECT l.latitude AS latitude, l.longitude AS longitude, l.title AS title,\n                               l.price AS price, l.size AS size, s.delta_percent AS delta_percent,\n                               ROUND(s.fair_price_per_sqm, 2) AS fair_eur_per_sqm, s.comps_500m AS comps_500m\n                        \n    FROM listings l\n    JOIN homeserver_listing_model_scores s ON s.listing_id = l.id AND s.model_family = 'ridge'\n    WHERE l.state = 'active' AND l.market = '$market'\n\n                          AND l.latitude IS NOT NULL AND l.longitude IS NOT NULL AND \n    EXISTS (SELECT 1 FROM listing_verdicts v WHERE v.listing_id = l.id AND v.verdict = 'accepted')\n\n                        ",
          "refId": "A"
        }
      ],
      "title": "Active listings, coloured by mispricing",
      "transparent": false,
      "type": "geomap"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "description": "Ranked by distance below the model's fair price. Titles link to the advert.",
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "title"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "targetBlank": true,
                    "title": "Open advert",
                    "url": "${__data.fields.link}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "link"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "delta %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "reducer": [],
          "show": false
        },
        "frameIndex": 0,
        "showHeader": true,
        "showTypeIcons": false
      },
      "repeatDirection": "h",
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "fredy-sqlite"
          },
          "format": "table",
          "queryText": "\n                        SELECT l.title AS title, l.link AS link, l.provider AS provider,\n                               l.price AS \"rent EUR\", l.size AS \"m2\",\n                               ROUND(l.price / l.size, 2) AS \"EUR/m2\",\n                               ROUND(s.fair_price_per_sqm, 2) AS \"fair EUR/m2\",\n                               ROUND(s.delta_percent, 1) AS \"delta %\",\n                               s.comps_500m AS comps,\n                               datetime(l.created_at / 1000, 'unixepoch') AS \"first seen\"\n                        \n    FROM listings l\n    JOIN homeserver_listing_model_scores s ON s.listing_id = l.id AND s.model_family = 'ridge'\n    WHERE l.state = 'active' AND l.market = '$market'\n\n                          AND \n    EXISTS (SELECT 1 FROM listing_verdicts v WHERE v.listing_id = l.id AND v.verdict = 'accepted')\n\n                          AND l.created_at BETWEEN ${__from} AND ${__to}\n                        ORDER BY s.delta_percent ASC\n                        LIMIT 50\n                        ",
          "refId": "A"
        }
      ],
      "title": "Best priced now",
      "transparent": false,
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "id": 0,
      "panels": [],
      "title": "The market",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "description": "The market's own asking-price trend, independent of the model.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "axisBorderShow": false,
            "drawStyle": "line",
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          },
          "decimals": 1,
          "unit": "currencyEUR"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 24
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "fredy-sqlite"
          },
          "format": "time_series",
          "queryText": "\n                        SELECT date(l.created_at / 1000, 'unixepoch') AS time,\n                               ROUND(AVG(l.price / l.size), 2) AS eur_per_sqm\n                        FROM listings l\n                        WHERE l.market = '$market' AND l.state = 'active' AND l.price > 0 AND l.size > 0\n                          AND l.created_at BETWEEN ${__from} AND ${__to}\n                        GROUP BY 1\n                        ORDER BY 1\n                        ",
          "refId": "A"
        }
      ],
      "title": "Daily EUR per m2 (mean of active asks)",
      "transformations": [
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "destinationType": "time",
                "targetField": "time"
              }
            ]
          }
        }
      ],
      "transparent": false,
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "description": "Mean asking EUR/m2 in approximate 1 km coordinate cells, for currently active listings.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#E69F00",
                "value": null
              }
            ]
