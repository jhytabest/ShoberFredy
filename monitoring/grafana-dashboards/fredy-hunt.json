          "queryText": "\n                        SELECT CAST(SUM(CASE WHEN status = 'ok' AND attempts = 1 THEN 1 ELSE 0 END) AS REAL)\n                               / MAX(1, COUNT(*)) AS hit_rate\n                        FROM homeserver_geocode_cache\n                        ",
