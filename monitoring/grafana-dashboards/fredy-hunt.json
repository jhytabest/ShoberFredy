      "title": "What it costs to find this",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "description": "Extraction cost, framed by what it bought: how many model calls each accepted advert took.",
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#E69F00",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 33
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "showPercentChange": false,
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "repeatDirection": "h",
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "fredy-sqlite"
          },
          "format": "table",
          "queryText": "\n                        SELECT CAST(\n                          (SELECT COUNT(*) FROM llm_call_audit a\n                           JOIN listings al ON al.id = a.listing_id\n                           WHERE al.market = '$market'\n                             AND a.started_at >= (strftime('%s','now') - 7*86400) * 1000)\n                          AS REAL\n                        ) / MAX(1, (\n                          SELECT COUNT(DISTINCT l.id) FROM listings l\n                          WHERE l.market = '$market' AND l.created_at >= (strftime('%s','now') - 7*86400) * 1000\n                            AND \n    EXISTS (SELECT 1 FROM listing_verdicts v WHERE v.listing_id = l.id AND v.verdict = 'accepted')\n\n                        )) AS calls_per_listing\n                        ",
          "refId": "A"
        }
      ],
      "title": "LLM calls per accepted listing",
      "transparent": false,
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "description": "OpenRouter-reported cost over seven days, divided by accepted listings in this market.",
      "fieldConfig": {
        "defaults": {
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#E69F00",
                "value": null
              }
            ]
          },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 33
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "showPercentChange": false,
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "repeatDirection": "h",
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "fredy-sqlite"
          },
          "format": "table",
          "queryText": "\n                        SELECT COALESCE((\n                          SELECT SUM(COALESCE(json_extract(a.usage_json, '$.cost'), 0))\n                          FROM llm_call_audit a\n                          JOIN listings al ON al.id = a.listing_id\n                          WHERE al.market = '$market'\n                            AND a.started_at >= (strftime('%s','now') - 7*86400) * 1000\n                        ), 0) / MAX(1, (\n                          SELECT COUNT(DISTINCT l.id) FROM listings l\n                          WHERE l.market = '$market' AND l.created_at >= (strftime('%s','now') - 7*86400) * 1000\n                            AND \n    EXISTS (SELECT 1 FROM listing_verdicts v WHERE v.listing_id = l.id AND v.verdict = 'accepted')\n\n                        )) AS usd_per_listing\n                        ",
          "refId": "A"
        }
      ],
      "title": "LLM USD per accepted listing",
      "transparent": false,
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "description": "From llm_call_audit.started_at/completed_at. Not cost, but the other half of what an extraction takes.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 8000
              },
              {
                "color": "red",
                "value": 20000
              }
            ]
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 33
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "showPercentChange": false,
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "repeatDirection": "h",
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "fredy-sqlite"
          },
          "format": "table",
          "queryText": "\n                        WITH durations AS (\n                          SELECT completed_at - started_at AS latency_ms,\n                                 ROW_NUMBER() OVER (ORDER BY completed_at - started_at) AS position,\n                                 COUNT(*) OVER () AS total\n                          FROM llm_call_audit a\n                          JOIN listings l ON l.id = a.listing_id\n                          WHERE l.market = '$market' AND a.outcome = 'success' AND a.completed_at IS NOT NULL\n                            AND a.started_at >= (strftime('%s','now') - 86400) * 1000\n                        )\n                        SELECT AVG(latency_ms) AS latency_ms\n                        FROM durations\n                        WHERE position IN ((total + 1) / 2, (total + 2) / 2)\n                        ",
          "refId": "A"
        }
      ],
      "title": "Median LLM latency",
      "transparent": false,
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
