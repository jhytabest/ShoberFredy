          "queryText": "\n                        SELECT COUNT(DISTINCT l.id) AS accepted\n                        FROM listings l\n                        WHERE l.market = '$market'\n                          AND l.created_at >= (strftime('%s','now') - 7*86400) * 1000\n                          AND \n    EXISTS (SELECT 1 FROM listing_verdicts v WHERE v.listing_id = l.id AND v.verdict = 'accepted')\n\n                        ",
