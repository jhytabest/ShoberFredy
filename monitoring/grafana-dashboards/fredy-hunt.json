          "format": "table",
          "queryText": "\n                        SELECT l.provider AS provider, COUNT(*) AS new_listings\n                        FROM listings l\n                        WHERE l.market = '$market' AND l.created_at >= strftime('%s','now','start of day') * 1000\n                        GROUP BY 1\n                        ",
