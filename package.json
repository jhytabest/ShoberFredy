{
  "name": "shoberfredy",
  "version": "1.0.0",
  "description": "Fredy searches ImmoScout24, Kleinanzeigen and WG-Gesucht for German rental listings and delivers them over Telegram.",
  "scripts": {
    "start": "NODE_ENV=production node index.js",
    "migratedb": "node lib/services/storage/migrations/migrate.js",
    "maintenance": "node --env-file-if-exists=.env.local tools/maintenance/database.js"
  },
  "type": "module",
  "main": "index.js",
  "author": "Sebastien Michel and Shoberfredy contributors",
  "keywords": [
    "flat",
    "flatfinder",
    "real estate",
    "germany",
    "apartment",
    "rent",
    "immoscout",
    "kleinanzeigen",
    "wg-gesucht",
    "scraper",
    "telegram"
  ],
  "bugs": {
    "url": "https://github.com/jhytabest/ShoberFredy/issues"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.22.1",
    "npm": ">=12.2.0"
  },
  "dependencies": {
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "cloakbrowser": "0.6.3",
    "nanoid": "6.0.2",
    "p-throttle": "^8.1.1",
    "puppeteer-core": "^25.15.0",
    "query-string": "9.5.1",
    "sharp": "^0.35.5"
  }
}
