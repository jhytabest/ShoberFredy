{
  "name": "shoberfredy",
  "version": "1.0.0",
  "description": "Fredy searches ImmoScout24, Immowelt, Kleinanzeigen and WG-Gesucht for German rental listings and delivers them over Telegram.",
  "scripts": {
    "prepare": "husky",
    "start:backend": "NODE_ENV=production node index.js",
    "start:backend:dev": "nodemon --watch index.js --watch lib",
    "format": "prettier --write \"**/*.js\"",
    "format:check": "prettier --check \"**/*.js\"",
    "lint": "eslint .",
    "lint:fix": "yarn lint --fix",
    "test": "node --test test/*.test.js",
    "migratedb": "node lib/services/storage/migrations/migrate.js",
    "market:setup": "python3 -m venv .market-venv && .market-venv/bin/pip install --disable-pip-version-check -r tools/market/requirements.txt",
    "market:exporter": "node tools/market/marketExporter.js",
    "maintenance": "node --env-file-if-exists=.env.local tools/maintenance/database.js",
    "copyright": "node ./copyright.js"
  },
  "type": "module",
  "lint-staged": {
    "*.js": [
      "yarn lint",
      "yarn format",
      "yarn copyright"
    ]
  },
  "main": "index.js",
  "author": "Sebastien Michel and Shoberfredy contributors",
  "keywords": [
    "flat",
    "flatfinder",
    "real estate",
    "germany",
    "apartment",
    "rent",
    "immoscout",
    "kleinanzeigen",
    "immowelt",
    "wg-gesucht",
    "scraper",
    "telegram"
  ],
  "bugs": {
    "url": "https://github.com/jhytabest/ShoberFredy/issues"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.20.0",
    "npm": ">=12.0.2"
  },
  "dependencies": {
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "cloakbrowser": "0.5.10",
    "fastify": "^5.12.1",
    "nanoid": "6.0.1",
    "node-cron": "^4.6.0",
    "node-fetch": "3.3.2",
    "p-throttle": "^8.1.0",
    "puppeteer-core": "^25.9.0",
    "query-string": "9.5.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "^17.11.0",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "nodemon": "^3.1.14",
    "prettier": "3.9.6"
  }
}
