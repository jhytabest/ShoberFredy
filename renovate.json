{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "npm"
      ],
      "rangeStrategy": "bump"
    },
    {
      "description": "Keep unrelated updates independently attributable and reversible.",
      "matchPackageNames": [
        "*"
      ],
      "groupName": null
    }
  ],
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": false,
  "ignoreTests": true
}
