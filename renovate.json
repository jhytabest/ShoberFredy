{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "constraints": {
    "python": "3.11"
  },
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "rangeStrategy": "bump"
    },
    {
      "description": "Automatically ship backwards-compatible updates after CI passes.",
      "matchUpdateTypes": ["digest", "pin", "pinDigest", "patch", "minor"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Keep unrelated updates independently attributable and reversible.",
      "matchPackageNames": ["*"],
      "groupName": null
    }
  ]
}
